# Supabase Configuration
# Obtenez ces valeurs depuis https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anonyme-supabase

# Local database connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/TsaraFidy
JWT_SECRET=change_this_secret_to_a_strong_value

# Redirection pour développement local
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Mode développement
NODE_ENV=development
